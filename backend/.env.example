# Period-report narrative drafting (server only; never use a VITE_ prefix).
# Add these to your existing backend .env without replacing other settings.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Keep the application closed while preparing a fresh deployment.
DEPLOYMENT_PENDING=true
ENABLE_EMBEDDED_INDEXER=false
ZAKAT_PROTOCOL_L1_ADDRESS=
SEPOLIA_USDC_ADDRESS=
INDEXER_START_BLOCK=0
# Fresh testnet deployer key, never the historical source-code fallback key.
DEPLOYER_PRIVATE_KEY=
DEPLOY_ADMIN_ADDRESS=
DEPLOY_RELAYER_ADDRESS=
DEPLOY_DPS_ADDRESS=
DEPLOY_AUDITOR_ADDRESS=

# Ruang kerja lembaga (Spec #68, ticket #69).
# Without DATABASE_URL the workspace routes answer 503 rather than falling back
# to memory. The schema is created additively on startup; it alters no existing
# table and backfills nothing.
DATABASE_URL=

# Restricted source attachments (#70). Generate 32 random bytes outside source
# control, store the 64 hex characters in the deployment secret manager.
# Missing key => attachment status FAILED, never plaintext storage.
EVIDENCE_FILE_KEY=
# Durable private volume outside the frontend/static document root.
EVIDENCE_FILE_DIR=.evidence-files

# Separate evidence registry. All five are required to enable recording; no vault fallback.
REPORT_REGISTRY_RPC_URL=
REPORT_REGISTRY_CHAIN_ID=
REPORT_REGISTRY_ADDRESS=
REPORT_REGISTRY_RELAYER_KEY=
REPORT_REGISTRY_CONFIRMATIONS=

# Accountless donor OTP access (#104). Codes are stored as HMACs under this key:
# 32 random bytes as 64 hex characters (`openssl rand -hex 32`), kept in the
# secret manager. Missing key = a per-process key; codes die on restart.
DONOR_OTP_KEY=
# Email channel through Resend. Both are required, or no channel is offered.
# The sender must be on a domain verified in Resend.
RESEND_API_KEY=
DONOR_OTP_EMAIL_FROM="ZKT <otp@example.org>"

# Issue #108: local EVM receipt tracer only (never a production key).
# All three must be set to enable endorsement/proof publication.
ZK_RPC_URL=http://127.0.0.1:8545
ZK_REGISTRY_ADDRESS=
ZK_RELAY_PRIVATE_KEY=
# Used only by src/scripts/zk-deploy-local.ts; same ID as SQL institution.
ZK_INSTITUTION_ID=
