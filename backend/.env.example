# Period-report narrative drafting (server only; never use a VITE_ prefix).
# Add these to your existing backend .env without replacing other settings.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Keep the application closed while preparing a fresh deployment.
DEPLOYMENT_PENDING=true
ENABLE_EMBEDDED_INDEXER=false
ZAKAT_PROTOCOL_L1_ADDRESS=
SEPOLIA_USDC_ADDRESS=
INDEXER_START_BLOCK=0
# Fresh testnet deployer key, never the historical source-code fallback key.
DEPLOYER_PRIVATE_KEY=
DEPLOY_ADMIN_ADDRESS=
DEPLOY_RELAYER_ADDRESS=
DEPLOY_DPS_ADDRESS=
DEPLOY_AUDITOR_ADDRESS=

# Ruang kerja lembaga (Spec #68, ticket #69).
# Without DATABASE_URL the workspace routes answer 503 rather than falling back
# to memory. The schema is created additively on startup; it alters no existing
# table and backfills nothing.
DATABASE_URL=
