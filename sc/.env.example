# ─────────────────────────────────────────────────────────────────────────────
# Ethereum Sepolia (chain 11155111) — THE deployment target for this project.
# Every contract in sc/broadcast/ was deployed here. Despite what older docs
# claimed, nothing is deployed on Base Sepolia.
# ─────────────────────────────────────────────────────────────────────────────
SEPOLIA_RPC_URL=https://ethereum-sepolia.publicnode.com
SEPOLIA_ACCOUNT=tawf-deployer
SEPOLIA_SENDER=

# Etherscan v2 key, used for --verify on Sepolia (see [etherscan] in foundry.toml)
ETHERSCAN_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# tawf-gov (DAO layer) addresses, read by script/V10Deploy.s.sol.
# These must point at an ALREADY-DEPLOYED tawf-gov system on the same chain.
# To deploy a fresh DAO layer first:
#   cd lib/tawf-gov/gov && forge script script/DeployTawfSystem.s.sol \
#     --rpc-url "$SEPOLIA_RPC_URL" --account "$SEPOLIA_ACCOUNT" --broadcast
# ─────────────────────────────────────────────────────────────────────────────
TAWF_PASSPORT=
TAWF_REPUTATION=
TAWF_VOTING_NFT=
TAWF_RECEIPT_NFT=
TAWF_IDRX=
TAWF_PROPOSAL_MANAGER=
TAWF_VOTING_MANAGER=
TAWF_MILESTONE_MANAGER=
TAWF_PARTICIPATION_TRACKER=
TAWF_POOL_MANAGER=
TAWF_ZAKAT_ESCROW=

# Address granted ORGANIZER / SHARIA_COUNCIL / KYC_ORACLE roles on ZKTCore.
CORE_TEAM_ADDRESS=

# ─────────────────────────────────────────────────────────────────────────────
# Local development
# ─────────────────────────────────────────────────────────────────────────────
ANVIL_RPC_URL=http://127.0.0.1:8545
ANVIL_ACCOUNT=zkt-anvil
ANVIL_SENDER=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# ─────────────────────────────────────────────────────────────────────────────
# Other networks — configured but NOT deployed to. Kept for future use.
# ─────────────────────────────────────────────────────────────────────────────
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_ACCOUNT=zkt-base-sepolia
BASE_SEPOLIA_SENDER=

BASE_RPC_URL=https://mainnet.base.org
BASE_ACCOUNT=zkt-base
BASE_SENDER=
